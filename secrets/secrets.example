#!/bin/bash
# secrets.example — copied to secrets.<stage> by ./install.sh, then read by
# `sudo ./setup.sh --<stage> --seed-vault`, which writes every value to Vault.
# SECTION 1 is yours to fill in. SECTION 2 is filled by install.sh or written
# back by --seed-vault; you do not touch it.
#
# --seed-vault checks every value BEFORE it writes anything and refuses the whole
# seed while one is empty.

################################################################################
# SECTION 1 — WHAT YOU FILL IN
#
# These cannot be generated. Obtain them first, then paste them in.
################################################################################

# GitHub fine-grained PAT, Contents: READ+WRITE on this repository.
# THE WRITER'S token, and only the writer's: the Controller commits registrations,
# cluster maps and release pins with it, and the master's own bootstrap ArgoCD reads
# it to sync. Nothing else may receive it — a namespace that only ever SYNCS gets
# GITOPS_REPO_READ_PAT below instead.
# Protect `master` with a GitHub ruleset (block deletions and force-pushes, no
# bypass actors). Install branches stay unprotected — the Reset wizard must be able
# to delete them.
GITOPS_REPO_PAT=""

# GitHub fine-grained PAT, Contents: READ on this repository. NO write.
# THE READER'S token. Every per-slave ArgoCD instance — each in its own namespace on
# the MASTER — syncs with this one. Those namespaces never commit anything: they read
# the install branch and apply it. Giving them the writer's token instead meant a
# namespace that only reads held the credential that can rewrite the books of every
# cluster in the installation, for no reason other than that one token existed.
# Two tokens, so least privilege is a fact rather than a comment.
GITOPS_REPO_READ_PAT=""

# Cloudflare API token, DNS only. My Profile → API Tokens → Create Custom Token:
#   Zone → DNS  → Edit      (create and update records)
#   Zone → Zone → Read      (zone-id lookup)
#   Zone Resources: your zone only, NOT "All zones".
# No account-level permission. Used for the cluster's own wildcard record, the
# one record a unit gets at onboarding, and the mail DNS.
CLOUDFLARE_API_TOKEN=""

# NO R2 TOKEN HERE. The account-scoped Cloudflare token the tenant operator
# mints per-tenant buckets and keys with belongs to that UNIT, not to this
# installation's platform tier: the operator is a consumer, and a consumer's
# Vault role can read only <stage>/consumer/<unit>/*. It is declared in the
# unit's own manifest as an operator-supplied secret and handed over at
# onboarding, which is also what puts it on the right cluster — the token is
# needed wherever tenants land, and onboarding happens per cluster.

# Hetzner Storage Box behind move, backup and restore.
#   HOST      the box hostname, uXXXXXX.your-storagebox.de
#   USER      a SUB-ACCOUNT (uXXXXXX-subN) — NEVER the main account, whose
#             password also unlocks the Hetzner Robot
#   PASSWORD  that sub-account's password
# Create the sub-account in Robot → Storage Box → sub-accounts, with SSH/SFTP
# enabled and its own directory.
STORAGE_BOX_HOST=""
STORAGE_BOX_USER=""
STORAGE_BOX_PASSWORD=""

# ---- Build plane only -------------------------------------------------------
# Fill the four below ONLY on the cluster that carries the build plane. On every
# other cluster install.sh fills them with an inert placeholder.

# Docker Hub username and a READ-only access token
# (hub.docker.com → Account settings → Personal access tokens).
# Without it the registry pulls upstream base images anonymously against this
# machine's public-IP rate limit, and once that is hit it blocks for about an hour.
REGISTRY_DOCKERHUB_USER=""
REGISTRY_DOCKERHUB_TOKEN=""

# GitHub PATs with Contents: READ+WRITE on this cloud's own repository and on
# this installation's TENANT CATALOG — the repository holding the tenant charts
# and their per-stage pins, which the release bump pushes to. One org PAT can
# back both; they are two variables so they can be rotated apart. The catalog is
# named per installation (the cluster map's deploy-repo), so its credential is
# named for what it IS rather than for which repository it opens.
BUILD_HOSTYOUR_CLOUD_REPO_PAT=""
BUILD_CATALOG_REPO_PAT=""

################################################################################
# SECTION 2 — FILLED BY install.sh, OR WRITTEN BACK BY --seed-vault
################################################################################

# --- Generated by install.sh --------------------------------------------------
MONGODB_ROOT_PASSWORD=""
MONGODB_REPLICA_SET_KEY=""
GRAFANA_ADMIN_PASSWORD=""
OBS_PUSH_PASSWORD=""
OBS_PUSH_HTPASSWD=""
IMAGE_BUILDER_GITHUB_WEBHOOK_SECRET=""
REGISTRY_PUSH_PASSWORD=""
REGISTRY_PULL_PASSWORD=""
REGISTRY_ADMIN_PASSWORD=""

# --- Fixed names, not secrets --------------------------------------------------
GRAFANA_ADMIN_USER="admin"
OBS_PUSH_USER="edge-push"
IDP_ADMIN_USER="akadmin"
REGISTRY_PUSH_USER="push-user"
REGISTRY_PULL_USER="pull-user"
REGISTRY_ADMIN_USER="admin"

# --- Written back by --seed-vault from the files the install produced ----------
# (deploy_idp → idp-<stage>.txt, the ArgoCD chart → argocd-<stage>.txt,
#  --get-kube-token → kube-<stage>.txt, vault operator init → vault-<stage>.txt)
# IDP_BOOTSTRAP_EMAIL is set in config.<stage>, not here.
IDP_BOOTSTRAP_EMAIL=""
IDP_BOOTSTRAP_PASSWORD=""
IDP_SECRET_KEY=""
IDP_POSTGRES_PASSWORD=""
IDP_ARGOCD_CLIENT_SECRET=""
IDP_GRAFANA_CLIENT_SECRET=""
IDP_HEADLAMP_CLIENT_SECRET=""
IDP_VAULT_CLIENT_SECRET=""
IDP_CONTROLLER_CLIENT_SECRET=""
ARGOCD_ADMIN_PASSWORD=""
KUBE_DASHBOARD_TOKEN=""
# Storing Vault's own root token and unseal keys inside Vault is convenience
# only: when Vault is sealed, secrets/vault-<stage>.txt is the ONLY way in.
VAULT_ROOT_TOKEN=""
VAULT_UNSEAL_KEY_1=""
VAULT_UNSEAL_KEY_2=""
VAULT_UNSEAL_KEY_3=""
VAULT_UNSEAL_KEY_4=""
VAULT_UNSEAL_KEY_5=""

# --- Multi-line values, rewritten in place by install.sh -----------------------

# DKIM signing key. install.sh generates it; `./setup.sh --generate-dkim-<stage>`
# prints the matching DNS records to publish.
POSTFIX_DKIM_PRIVATE_KEY=$(cat <<'EOF'
-----BEGIN RSA PRIVATE KEY-----
…paste PEM here…
-----END RSA PRIVATE KEY-----
EOF
)

# One bcrypt line per registry user. install.sh replaces each line in place.
REGISTRY_HTPASSWD=$(cat <<'EOF'
push-user:$2y$10$replace-with-bcrypt-hash-of-REGISTRY_PUSH_PASSWORD
pull-user:$2y$10$replace-with-bcrypt-hash-of-REGISTRY_PULL_PASSWORD
admin:$2y$10$replace-with-bcrypt-hash-of-REGISTRY_ADMIN_PASSWORD
EOF
)

# The imagePullSecret every workload namespace uses. On the build plane install.sh
# composes it from the pull password above; elsewhere it must be keyed on the
# BUILD PLANE's zot host, and install.sh copies it from that checkout when one is
# on this machine.
REGISTRY_PULL_DOCKERCONFIGJSON='{"auths":{"zot.<DOMAIN_SUFFIX>":{"auth":"BASE64_OF_pull-user:REGISTRY_PULL_PASSWORD"}}}'

################################################################################
# SCHEMA — DO NOT EDIT unless you also change apps/<name>/values-*.yaml.
#
# <SHELL_VAR_NAME>|<category>|<name>|<vault-key>
# One Vault entry per (category,name) at secret/data/${DEPLOY_ENV}/<category>/<name>.
#   app     — readable by ESO; the name is also bound to the external-secrets role
#   system  — control plane, ESO cannot read it
################################################################################
VAULT_SCHEMA=(
  "MONGODB_ROOT_PASSWORD|app|mongodb|mongodb-root-password"
  "MONGODB_REPLICA_SET_KEY|app|mongodb|mongodb-replica-set-key"


  "POSTFIX_DKIM_PRIVATE_KEY|app|postfix|dkim-private-key"

  "GRAFANA_ADMIN_USER|app|observability|admin-user"
  "GRAFANA_ADMIN_PASSWORD|app|observability|grafana-admin-password"
  "OBS_PUSH_USER|app|observability|push-username"
  "OBS_PUSH_PASSWORD|app|observability|push-password"
  "OBS_PUSH_HTPASSWD|app|observability|push-htpasswd"

  "IMAGE_BUILDER_GITHUB_WEBHOOK_SECRET|app|image-builder|github-webhook-secret"

  "IDP_GRAFANA_CLIENT_SECRET|app|idp|grafana-client-secret"
  "IDP_POSTGRES_PASSWORD|app|idp|postgres-password"
  "IDP_ADMIN_USER|system|idp|admin-user"
  "IDP_BOOTSTRAP_EMAIL|system|idp|bootstrap-email"
  "IDP_BOOTSTRAP_PASSWORD|system|idp|bootstrap-password"
  "IDP_SECRET_KEY|system|idp|secret-key"
  "IDP_ARGOCD_CLIENT_SECRET|system|idp|argocd-client-secret"
  "IDP_HEADLAMP_CLIENT_SECRET|system|idp|headlamp-client-secret"
  "IDP_VAULT_CLIENT_SECRET|system|idp|vault-client-secret"

  "IDP_CONTROLLER_CLIENT_SECRET|app|controller|oidc-client-secret"
  # The Controller's master SSH key is deliberately NOT here: it lives on the
  # isolated secret/<env>/controller-host/ssh path, written by
  # base/lib/controller-master-key.sh. app/* would be far too broad for it.
  "GITOPS_REPO_PAT|system|argocd|repo-pat"
  # The read-only twin, seeded beside it. --slave-add copies THIS one into the
  # slaves tier; the writer above never leaves the system tier.
  "GITOPS_REPO_READ_PAT|system|argocd|repo-read-pat"
  # Same token, second path: the Controller cannot reach the system tier, so it
  # reads the write-capable copy from its own isolated tier.
  "GITOPS_REPO_PAT|controller-host|github|write-pat"

  "REGISTRY_PUSH_USER|app|registry|push-user"
  "REGISTRY_PUSH_PASSWORD|app|registry|push-password"
  "REGISTRY_PULL_USER|app|registry|pull-user"
  "REGISTRY_PULL_PASSWORD|app|registry|pull-password"
  "REGISTRY_ADMIN_USER|app|registry|admin-user"
  "REGISTRY_ADMIN_PASSWORD|app|registry|admin-password"
  "REGISTRY_HTPASSWD|app|registry|htpasswd"
  "REGISTRY_PULL_DOCKERCONFIGJSON|app|registry|pull-dockerconfigjson"
  "REGISTRY_DOCKERHUB_USER|app|registry|dockerhub-user"
  "REGISTRY_DOCKERHUB_TOKEN|app|registry|dockerhub-token"

  # storage-box and cloudflare-dns are not namespaces — the name only keys the
  # Vault entry; the Controller reads both.
  "STORAGE_BOX_HOST|app|storage-box|host"
  "STORAGE_BOX_USER|app|storage-box|user"
  "STORAGE_BOX_PASSWORD|app|storage-box|password"

  "CLOUDFLARE_API_TOKEN|app|cloudflare-dns|api-token"

  "ARGOCD_ADMIN_PASSWORD|system|argocd|admin-password"
  "KUBE_DASHBOARD_TOKEN|system|kube|dashboard-token"
  "VAULT_ROOT_TOKEN|system|vault|root-token"
  "VAULT_UNSEAL_KEY_1|system|vault|unseal-key-1"
  "VAULT_UNSEAL_KEY_2|system|vault|unseal-key-2"
  "VAULT_UNSEAL_KEY_3|system|vault|unseal-key-3"
  "VAULT_UNSEAL_KEY_4|system|vault|unseal-key-4"
  "VAULT_UNSEAL_KEY_5|system|vault|unseal-key-5"
)
